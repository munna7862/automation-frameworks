# ==============================================================================
# Selenium WebDriver E2E Automation — Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env inside selenium-e2e/ for local execution.
# Sensitive tokens and real credentials should never be committed to Git.

# Environment Identifier (qa, staging, local)
ENV=staging

# Target Application URLs
BASE_URL=https://buggy-books-fe.onrender.com
API_BASE_URL=https://buggy-books.onrender.com/api

# Test User Credentials
USER_NAME=admin
PASSWORD=password123

# Browser & Execution Controls (Strict Single-Browser Policy: Chrome Only)
BROWSER=chrome
HEADLESS=true
ELEMENT_TIMEOUT=15000

# Reporting & Suite Metadata
SUITENAME=Default
