{
  "name": "@automationframeworks/test-data",
  "version": "1.0.0",
  "description": "Shared test data engineering, seeders, factories, and typed configuration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ scripts/",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "data:perf": "tsx scripts/generate-perf-datasets.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "test-data",
    "faker",
    "factories",
    "seeders",
    "zod"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0"
  }
}
