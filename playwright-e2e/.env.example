# ==============================================================================
# Playwright E2E & API Automation — Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env inside playwright-e2e/ for local execution.
# Sensitive tokens and real credentials should never be committed to Git.

# Environment Identifier (qa, staging, local)
ENV=qa

# Target Application URLs
BASE_URL=https://buggy-books-fe.onrender.com
API_BASE_URL=https://buggy-books.onrender.com

# Browser & Execution Controls (Strict Single-Browser Policy: Chrome Only)
BROWSER=chrome
CHANNEL=chrome
HEADLESS=true
WORKERS=2
RETRIES=1
CI=false

# Timeouts & SLAs
ELEMENT_TIMEOUT=15000

# Authentication & Test Accounts
USER_NAME=admin
PASSWORD=password123

# Reporting & Suite Metadata
SUITENAME=Default
