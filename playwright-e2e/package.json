{
  "name": "playwright-e2e",
  "version": "1.0.0",
  "description": "Playwright E2E Automation Framework for BuggyBooks",
  "main": "index.js",
  "scripts": {
    "test": "cross-env TZ=Australia/Adelaide npx playwright test --config=src/config/playwright.config.ts",
    "test:api": "cross-env TZ=Australia/Adelaide npx playwright test --config=src/config/playwright.config.ts --project=api",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test:smoke": "cross-env TZ=Australia/Adelaide npx playwright test --config=src/config/playwright.config.ts --grep \"@smoke\" --grep-invert \"@quarantine\"",
    "test:security": "cross-env TZ=Australia/Adelaide npx playwright test --config=src/config/playwright.config.ts --grep \"@security\"",
    "test:quarantine": "cross-env TZ=Australia/Adelaide npx playwright test --config=src/config/playwright.config.ts --grep \"@quarantine\" --grep-invert \"\"",
    "test:quarantine:audit": "node scripts/quarantine-audit.js",
    "test:e2e:local": "cross-env TZ=Australia/Adelaide npx playwright test --config=src/config/playwright.config.ts --grep \"@smoke\" --project=chrome",
    "test:e2e:chrome": "cross-env TZ=Australia/Adelaide npx playwright test --config=src/config/playwright.config.ts --project=chrome",
    "test:e2e:ui": "cross-env TZ=Australia/Adelaide npx playwright test --config=src/config/playwright.config.ts --project=chrome",
    "test:e2e:visual": "cross-env TZ=Australia/Adelaide npx playwright test src/tests/ui/VisualRegression --config=src/config/playwright.config.ts --project=chrome",
    "test:e2e:all": "cross-env TZ=Australia/Adelaide npx playwright test --config=src/config/playwright.config.ts",
    "generate-allure": "node ../scripts/generate-allure-environment.js --framework=playwright && allure generate --clean allure-results -o allure-report",
    "open-allure": "allure open allure-report",
    "report": "npm run generate-allure && npm run open-allure",
    "clean": "npm run clean-reports",
    "clean-reports": "rimraf reports logs playwright-report test-results allure-results allure-report",
    "save-snapshot": "ts-node scripts/save-snapshot.ts",
    "finalize-spec": "ts-node scripts/finalize-spec.ts",
    "merge:monocart": "node scripts/merge-monocart.js",
    "test:contract:consumer": "tsx contract-tests/consumer/run-consumer-tests.ts",
    "test:contract:provider": "tsx contract-tests/provider/provider.verify.ts",
    "test:contract": "npm run test:contract:consumer && npm run test:contract:provider",
    "har:record": "tsx scripts/record-har.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.0.10",
    "allure-commandline": "^2.34.1",
    "allure-js-commons": "^3.13.0",
    "allure-playwright": "^3.13.0",
    "eslint": "^10.10.0",
    "eslint-plugin-playwright": "^2.12.0",
    "globals": "^17.12.0",
    "monocart-reporter": "^2.14.0",
    "rimraf": "^5.0.0",
    "socket.io-client": "^4.8.4",
    "testcontainers": "^10.28.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@automationframeworks/playwright-utils": "*",
    "@automationframeworks/test-data": "*",
    "@pact-foundation/pact": "^17.1.4",
    "axios": "^1.20.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "winston": "^3.19.0",
    "yaml": "^2.8.0",
    "zod": "^3.24.2"
  }
}
