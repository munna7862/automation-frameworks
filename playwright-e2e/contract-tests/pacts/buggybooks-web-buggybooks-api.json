{
  "consumer": {
    "name": "buggybooks-web"
  },
  "interactions": [
    {
      "description": "a request for books catalog with pagination",
      "providerStates": [
        {
          "name": "books exist in catalog"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/books",
        "query": {
          "limit": ["8"],
          "page": ["1"]
        }
      },
      "response": {
        "body": {
          "books": [
            {
              "author": "F. Scott Fitzgerald",
              "id": "1",
              "image": "https://images.unsplash.com/photo-1544947950-fa07a98d237f",
              "price": 10.99,
              "title": "The Great Buggy Gatsby"
            }
          ],
          "limit": 8,
          "page": 1,
          "total": 15,
          "totalPages": 2
        },
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "matchingRules": {
          "body": {
            "$.books": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.books[*].author": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.books[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.books[*].image": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.books[*].price": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            },
            "$.books[*].title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.limit": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.page": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.total": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.totalPages": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^application/json.*"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request for customer order history",
      "providerStates": [
        {
          "name": "user has historical orders"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer sample-token"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^Bearer .+"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/orders"
      },
      "response": {
        "body": [
          {
            "customerName": "Jane Doe",
            "date": "2026-10-06T12:00:00Z",
            "id": "ord-12345",
            "items": [
              {
                "id": "1",
                "price": 10.99,
                "title": "The Great Buggy Gatsby"
              }
            ],
            "total": 10.99
          }
        ],
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].customerName": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].date": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].items": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].items[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].items[*].price": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            },
            "$[*].items[*].title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].total": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^application/json.*"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
