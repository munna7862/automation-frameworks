      "body": "{\"books\":[{\"id\":\"9\",\"title\":\"War and Parse\",\"author\":\"Leo Tolstoy\",\"price\":17.99,\"genre\":\"Classic\",\"description\":\"An epic battle between JSON and XML parsers.\",\"image\":\"https%3A%2F%2Fimages.unsplash.com%2Fphoto-1495446815901-a7297e633e8d%3Fq=80&w=600&auto=format&fit=crop\",\"stock\":10,\"version\":1},{\"id\":\"10\",\"title\":\"Crime and Refactoring\",\"author\":\"Fyodor Dostoevsky\",\"price\":14.5,\"genre\":\"Thriller\",\"description\":\"A developer's guilt-ridden journey of merging to production.\",\"image\":\"https%3A%2F%2Fimages.unsplash.com%2Fphoto-1506880018603-83d5b814b5a6%3Fq=80&w=600&auto=format&fit=crop\",\"stock\":10,\"version\":1},{\"id\":\"11\",\"title\":\"Brave New Debug World\",\"author\":\"Aldous Huxley\",\"price\":11.99,\"genre\":\"Dystopian\",\"description\":\"A world where logging is banned and breakpoints are illegal.\",\"image\":\"https%3A%2F%2Fimages.unsplash.com%2Fphoto-1614332287897-cdc485fa562d%3Fq=80&w=600&auto=format&fit=crop\",\"stock\":10,\"version\":1},{\"id\":\"12\",\"title\":\"Of Memory and Men\",\"author\":\"John Steinbeck\",\"price\":9.5,\"genre\":\"Classic\",\"description\":\"Two developers dream of the perfect memory allocation scheme.\",\"image\":\"https%3A%2F%2Fimages.unsplash.com%2Fphoto-1524995997946-a1c2e315a42f%3Fq=80&w=600&auto=format&fit=crop\",\"stock\":10,\"version\":1},{\"id\":\"13\",\"title\":\"Fahrenheit 500: Internal Server Error\",\"author\":\"Ray Bradbury\",\"price\":12.99,\"genre\":\"Dystopian\",\"description\":\"A society that burns documentation.\",\"image\":\"https%3A%2F%2Fimages.unsplash.com%2Fphoto-1541963463532-d68292c34b19%3Fq=80&w=600&auto=format&fit=crop\",\"stock\":10,\"version\":1},{\"id\":\"14\",\"title\":\"The Catcher in the Deploy\",\"author\":\"J.D. Salinger\",\"price\":10,\"genre\":\"Classic\",\"description\":\"Holden catches failed deployments before they hit production.\",\"image\":\"https%3A%2F%2Fimages.unsplash.com%2Fphoto-1532012197267-da84d127e765%3Fq=