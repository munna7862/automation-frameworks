# ==============================================================================
# BuggyBooks Test Automation Framework — Global Environment Variables (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables as required for local execution.
# DO NOT commit real secrets or production passwords into this repository.

# BuggyBooks Staging URLs
BASE_URL=https://buggy-books-fe.onrender.com
API_BASE_URL=https://buggy-books.onrender.com/api

# Test Execution Defaults
DEFAULT_BROWSER=chrome
HEADLESS=true
ELEMENT_TIMEOUT=15000

# Authentication Defaults (Staging Test User)
TEST_USER=testuser@example.com
TEST_PASSWORD=Password123!
