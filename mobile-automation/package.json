{
  "name": "mobile-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Appium 2.x + WebdriverIO + TypeScript Mobile Automation Framework for BuggyBooks",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "driver:android": "appium driver install uiautomator2",
    "driver:ios": "appium driver install xcuitest",
    "test:android": "wdio run src/config/wdio.android.conf.ts",
    "test:ios": "wdio run src/config/wdio.ios.conf.ts",
    "test:smoke": "wdio run src/config/wdio.android.conf.ts --spec src/specs/auth.e2e.spec.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "report:allure": "node ../scripts/generate-allure-environment.js --framework=mobile && allure generate allure-results --clean -o allure-report",
    "clean": "rimraf reports logs allure-results allure-report"
  },
  "dependencies": {
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@wdio/allure-reporter": "^9.3.9",
    "@wdio/appium-service": "^9.3.9",
    "@wdio/cli": "^9.3.9",
    "@wdio/globals": "^9.3.9",
    "@wdio/local-runner": "^9.3.9",
    "@wdio/mocha-framework": "^9.3.9",
    "@wdio/spec-reporter": "^9.3.9",
    "@wdio/types": "^9.3.9",
    "allure-commandline": "^2.32.0",
    "allure-js-commons": "^3.4.1",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^3.8.0",
    "appium-xcuitest-driver": "^7.26.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "webdriverio": "^9.3.9"
  }
}
