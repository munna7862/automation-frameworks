{
  "name": "automation-frameworks-monorepo",
  "version": "1.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "playwright-e2e",
    "selenium-e2e",
    "wdio-e2e",
    "k6-performance",
    "mobile-automation"
  ],
  "scripts": {
    "lint:all": "npm run lint --workspaces --if-present",
    "typecheck:all": "npm run typecheck --workspaces --if-present",
    "test:smoke:all": "npm run test:smoke --workspace=playwright-e2e",
    "test:playwright:smoke": "npm run test:smoke --workspace=playwright-e2e",
    "test:selenium:smoke": "npm run test:smoke --workspace=selenium-e2e",
    "test:wdio:smoke": "npm run test:smoke --workspace=wdio-e2e",
    "test:mobile:android": "npm run test:android --workspace=mobile-automation",
    "test:mobile:ios": "npm run test:ios --workspace=mobile-automation",
    "test:mobile:smoke": "npm run test:smoke --workspace=mobile-automation",
    "test:all:smoke": "npm run test:playwright:smoke && npm run test:selenium:smoke && npm run test:wdio:smoke",
    "perf:smoke": "npm run perf:smoke --workspace=k6-performance",
    "perf:drift-check": "npm run perf:drift-check --workspace=k6-performance",
    "generate-allure:env": "node scripts/generate-allure-environment.js --all",
    "generate-portal:metadata": "node scripts/generate-portal-metadata.js",
    "test:portal": "node scripts/test-portal.js",
    "test:verify-catalog": "tsx scripts/verify-catalog-sync.ts",
    "test:api-coverage": "tsx scripts/api-coverage.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:lint": "redocly lint docs/api/openapi.yaml",
    "openapi:docs": "redocly build-docs docs/api/openapi.yaml -o AutomationReports/API-Docs/index.html",
    "test:contract:consumer": "npm run test:contract:consumer --workspace=playwright-e2e",
    "test:contract:provider": "npm run test:contract:provider --workspace=playwright-e2e",
    "test:contract": "npm run test:contract --workspace=playwright-e2e",
    "test:quarantine:audit": "npm run test:quarantine:audit --workspace=playwright-e2e",
    "data:perf": "tsx packages/test-data/scripts/generate-perf-datasets.ts",
    "env:up": "docker compose -f infra/docker-compose.test.yml up -d --wait && npx wait-on -t 60000 http://localhost:4000/api/books http://localhost:5173/",
    "env:down": "docker compose -f infra/docker-compose.test.yml down -v --remove-orphans",
    "env:logs": "docker compose -f infra/docker-compose.test.yml logs -f",
    "test:smoke:docker": "cross-env ENV=DOCKER BASE_URL=http://localhost:5173 API_BASE_URL=http://localhost:4000 npm run test:smoke:all",
    "test:pr": "npm run lint:all && npm run typecheck:all && npm run test:verify-catalog && npm run test:smoke:docker",
    "test:pw": "cross-env ENV=DOCKER BASE_URL=http://localhost:5173 API_BASE_URL=http://localhost:4000 npm run test:e2e:all --workspace=playwright-e2e",
    "test:selenium": "cross-env ENV=DOCKER BASE_URL=http://localhost:5173 API_BASE_URL=http://localhost:4000 npm test --workspace=selenium-e2e",
    "test:wdio": "cross-env ENV=DOCKER BASE_URL=http://localhost:5173 API_BASE_URL=http://localhost:4000 npm test --workspace=wdio-e2e",
    "test:security": "npm run test:security --workspace=playwright-e2e",
    "perf:jmeter": "jmeter -n -t jmeter/Tests/BuggyBooks_Catalog_Load.jmx -l jmeter/Results/catalog_report.jtl -e -o jmeter/Results/html-dashboard -Jserver.host=localhost -Jserver.port=4000",
    "report:allure": "npm run report --workspace=playwright-e2e",
    "security:scan": "node scripts/run-security-scan.js",
    "clean": "npm run clean --workspaces --if-present",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@redocly/cli": "^2.59.0",
    "cross-env": "^10.1.0",
    "eslint-plugin-mocha": "^12.0.2",
    "eslint-plugin-wdio": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "yaml": "^2.9.1"
  }
}
